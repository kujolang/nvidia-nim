func get(o, k, f) { if type(o) == "dict" && has_key(o, k) { return o[k] }; return f }
func provider_impl(config) { if type(config) != "dict" { config := {} }; return {"name": "nvidia-nim", "base_url": get(config, "base_url", "https://integrate.api.nvidia.com/v1"), "chat_path": "/chat/completions", "api_key_env": "NVIDIA_API_KEY", "default_model": get(config, "model", ""), "capabilities": {"streaming": true, "tool_calls": true, "json_mode": true}, "driver": driver()} }
func describe(p) { return {"id": "nvidia-nim-openai-compatible", "protocol": "nim-openai-compatible", "auth": {"mode": "bearer"}, "capabilities": p["capabilities"]} }
func validate(p) { if type(p) != "dict" || get(p, "base_url", "") == "" { return {"ok": false, "errors": [{"field": "base_url", "message": "NIM base URL required."}] } }; return {"ok": true, "errors": []} }
func encode_chat(ctx) { o := ctx["resolved_options"]; return {"url": ctx["provider"]["base_url"] + "/chat/completions", "method": "POST", "headers": {"Content-Type": "application/json"}, "protected_headers": ["Authorization", "Content-Type"], "body": to_json({"model": get(o, "model", ctx["provider"]["default_model"]), "messages": ctx["messages"], "stream": get(o, "stream", false)}), "stream_mode": get(o, "stream", false)} }
func decode_chat(ctx) { d := ctx["data"]; cs := get(d, "choices", []); first := {}; if len(cs) > 0 { first := cs[0] }; m := get(first, "message", {}); u := get(d, "usage", {}); return {"ok": true, "request_id": get(d, "id", ""), "model": get(d, "model", ctx["fallback_model"]), "output_text": get(m, "content", ""), "finish_reason": get(first, "finish_reason", "stop"), "tool_calls": get(m, "tool_calls", []), "usage": {"input_tokens": get(u, "prompt_tokens", 0), "output_tokens": get(u, "completion_tokens", 0), "total_tokens": get(u, "total_tokens", 0)}, "raw_provider": d} }
func decode_error(ctx) { d := ctx["data"]; if type(d) != "dict" || has_key(d, "error") == 0 { return {"ok": false, "matched": false} }; return {"ok": false, "matched": true, "category": "provider", "message": get(d, "error", "NIM request failed"), "provider_code": "nvidia_nim_error", "raw_provider": d} }
func driver() { return {"contract": "ai-sdk-provider-driver", "version": "1.0.0", "id": "nvidia-nim-openai-compatible", "describe": describe, "validate": validate, "encode_chat": encode_chat, "decode_chat": decode_chat, "decode_error": decode_error} }
export nvidia_nim_provider := provider_impl
export nvidia_nim_driver := driver
